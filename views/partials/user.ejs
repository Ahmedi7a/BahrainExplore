<div class="row g-0 align-items-center rounded-3 border shadow-lg">
    <div class="col-lg-7 p-4">
      <h1 class="display-4 fw-bold lh-1 text-body-emphasis">Welcome to Your Bahrain Travel Guide, <%= user.username %>!</h1>
      <p class="lead">Discover and organize the best places to visit in Bahrain. From top restaurants to entertainment hotspots and cultural landmarks, plan your journey effortlessly with our easy-to-use platform.</p>
      <div class="d-grid gap-2 d-md-flex justify-content-md-start">
      </div>
    </div>
    <div class="col-lg-5 d-flex justify-content-center align-items-center">
        <img class="rounded-lg-3 img-fluid" src="https://i.pinimg.com/736x/45/13/89/451389fc40fdbbab7dfd180fabe2c925.jpg" alt="Bahrain skyline" style="max-width: 100%; height: auto;">
    </div>
</div>

<!-- ============================================== -->
<div class="px-4 pt-5 my-5 text-center border-bottom">
    <h1 class="display-4 fw-bold text-body-emphasis">Plan Your Perfect Trip</h1>
    <div class="col-lg-6 mx-auto">
        <p class="lead mb-4">
            Create and manage your personalized list of must-visit places in Bahrain. Save your favorite restaurants, entertainment spots, and cultural destinations—all in one place.
        </p>
        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center mb-5">
            <a href="/users/:userId/places/new" class="btn btn-danger btn-lg px-4 me-sm-3">Add a new location</a>
        </div>
    </div>
    <div class="overflow-hidden" style="max-height: 30vh;">
        <div class="container px-5">
            <img src="https://www.imtilakgroup.com/cdn-cgi/image/format=auto,fit=contain,width=1200,height=630/https://imt-assets.fra1.digitaloceanspaces.com/Safaraq/posts/f6e1ff32786faea5463a21081af936d85Io_66367v.jpg"
                class="img-fluid border rounded-3 shadow-lg mb-4" alt="Bahrain flag" width="430" height="400"
                loading="lazy">
        </div>
    </div>
</div>

