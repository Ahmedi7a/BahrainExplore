<%- include('../partials/head') %>

  <div class="container d-flex justify-content-center align-items-start" style="min-height: 80vh;">
    <div class="card shadow-lg p-4" style="max-width: 400px; width: 100%; margin-top: 50px;">
      <h1 class="text-center mb-4">Sign in to your account!</h1>
      <form action="/auth/sign-in" method="POST" class="needs-validation" novalidate>
        
        <div class="mb-3">
          <label for="username" class="form-label">Username:</label>
          <input type="text" name="username" id="username" class="form-control" required>
          <div class="invalid-feedback">
            Please enter your username.
          </div>
        </div>

        <div class="mb-3">
          <label for="password" class="form-label">Password:</label>
          <input type="password" name="password" id="password" class="form-control" required>
          <div class="invalid-feedback">
            Please enter your password.
          </div>
        </div>

        <button type="submit" class="btn btn-primary w-100">Sign in</button>
        <p class="text-center mt-3">
          <%= msg %>
        </p>
      </form>
    </div>
  </div> 

  <%- include('../partials/footer') %>

  <script>
  // took it from bootstrap
  (function () {
      'use strict'
      var forms = document.querySelectorAll('.needs-validation')
      Array.prototype.slice.call(forms)
        .forEach(function (form) {
          form.addEventListener('submit', function (event) {
            if (!form.checkValidity()) {
              event.preventDefault()
              event.stopPropagation()
            }
            form.classList.add('was-validated')
          }, false)
        })
    })()
  </script>
