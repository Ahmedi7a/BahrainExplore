<%- include('../partials/head') %>
    <div class="container">
        <section class="py-5 text-center container">
            <div class="row py-lg-5">
                <div class="col-lg-6 col-md-8 mx-auto">
                    <h1 class="fw-light">This is <%= user.username %> Location selections</h1>
                    <p class="lead text-body-secondary">Here you can see the <%= user.username %> selected locations for their trip, along with their planned schedule. Explore the places they've chosen and get inspired for your next adventure in Bahrain!</p>
                    <a href="/users" class="btn btn-primary">Back</a>
                </div>
            </div>
        </section>
     <!-- ========================================== -->
     <div class="album py-5 bg-body-tertiary">
        <div class="container">
    
            <% user.places.forEach(place => { %>  
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
                    <div class="col">
                      <div class="card mt-2 shadow-sm" style="width: 18rem;">
                        <img src="<%= place.imgUrl.url %>" class="card-img-top" alt="image">
                        <div class="card-body">
                          <h5 class="card-title"><%= place.name %></h5>
                          <a href="<%= place.location %>">Location</a>
                          <div class="d-flex justify-content-between align-items-center">
                            <div class="btn-group">
                            </div>
                            <% if (place.category === 'Restaurant') { %>
                                <span class="badge bg-warning"><%= place.category %></span>
                              <% } else if (place.category === 'Historical') { %>
                                <span class="badge bg-info"><%= place.category %></span>
                              <% } else if (place.category === 'Cafe') { %>
                                <span class="badge bg-secondary"><%= place.category %></span>
                              <% } else if (place.category === 'Mall') { %>
                                <span class="badge bg-danger"><%= place.category %></span>
                              <% } else if (place.category === 'Entertainment') { %>
                                <span class="badge bg-success"><%= place.category %></span>
                              <% } %>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                     
    		<% }) %>
     
    </div>
  </body>
  </html>