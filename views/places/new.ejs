<%- include('../partials/head') %>
    <div class="container">
        <h1> Add a new Place</h1>
        <form action="/users/<%= user._id %>/places/new" method="POST">
            <label for="name">Place Name:</label>
            <input type="text" name="name" id="name">
            
            <label for="location">Location:</label>
            <input type="text" name="location" id="location">
            
            <label for="description">Description:</label>
            <textarea name="description" id="description"></textarea>
            
            <!-- <label for="imgUrl" class="form-label">Image:</label>
            <input class="form-control" name="imgUrl" type="file" id="imgUrl" multiple /> -->
            <label for="imgUrl">Image:</label>
            <input type="text" name="imgUrl" id="imgUrl">
        
            <label for="category">Category:</label>
            <select id="category" name="category">
              <option value="" selected disabled></option> 
              <option value="Restaurant">Restaurant</option> 
              <option value="Historical">Historical Site</option>
              <option value="Cafe">Cafe</option>
              <option value="Mall">Mall</option>
              <option value="Entertainment">Entertainment</option>
            </select>
            <!-- value is the same in the model -->
             <button type="submit" class="btn btn-primary">Add Place</button>
          </form>
    </div>
<%- include('../partials/footer') %>