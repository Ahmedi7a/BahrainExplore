<%- include('../partials/head') %>
    <div class="container">
        <section class="py-5 text-center container">
            <div class="row py-lg-5">
              <div class="col-lg-6 col-md-8 mx-auto">
                <h1 class="fw-light">All Your places</h1>
                <p class="lead text-body-secondary">Something short and leading about the collection below—its contents, the creator, etc. Make it short and sweet, but not too short so folks don’t simply skip over it entirely.</p>
                <p>
                  <a href="/users/<%=user._id %>/places/new" class="btn btn-primary my-2">Add a Place</a>
                  <a href="#" class="btn btn-secondary my-2">Secondary action</a>
                </p>
              </div>
            </div>
          </section>
     <!-- ========================================== -->
     <div class="album py-5 bg-body-tertiary">
        <div class="container">
    
            <% places.forEach(place => { %>  
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
                    <div class="col">
                      <div class="card mt-2 shadow-sm" style="width: 18rem;">
                        <img src="<%= place.imgUrl %>" class="card-img-top" alt="image">
                        <div class="card-body">
                          <h5 class="card-title"><%= place.name %></h5>
                          <p class="card-text"><%= place.location %></p>
                          <div class="d-flex justify-content-between align-items-center">
                            <div class="btn-group">
                              <a href="/users/<%= user._id %>/places/<%= place._id %>" class="btn btn-sm btn-outline-secondary">View</a>
                            </div>
                            <% if (place.category === 'Restaurant') { %>
                                <span class="badge bg-warning"><%= place.category %></span>
                              <% } else if (place.category === 'Historical') { %>
                                <span class="badge bg-info"><%= place.category %></span>
                              <% } else if (place.category === 'Cafe') { %>
                                <span class="badge bg-secondary"><%= place.category %></span>
                              <% } else if (place.category === 'Mall') { %>
                                <span class="badge bg-danger"><%= place.category %></span>
                              <% } else { %>
                                <span class="badge bg-success"><%= place.category %></span>
                              <% } %>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                     
    		<% }) %>
     
    </div>
<%- include('../partials/footer') %>
