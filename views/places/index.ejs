<%- include('../partials/head') %>
    <div class="container">
        <section class="py-5 text-center container">
            <div class="row py-lg-5">
              <div class="col-lg-6 col-md-8 mx-auto">
                <h1 class="fw-light">All Your Selected Places</h1>
                <p class="lead text-body-secondary">Discover all the amazing places you've added in Bahrain. Explore the details of each location and make the most of your time in this beautiful country. Whether you're a visitor or a local, there's always something new to enjoy in Bahrain!</p>
                  <a href="/users/<%=user._id %>/places/new" class="btn btn-primary my-2">Add a Place</a>
                  <a href="https://www.getyourguide.co.uk/-l169064/?cmp=bing&ad_id=78684009898703&adgroup_id=1258942125139551&bid_match_type=bb&campaign_id=710370611&device=c&feed_item_id=&keyword=visiting+bahrain&loc_interest_ms=204&loc_physical_ms=143141&match_type=b&msclkid=f57bcbda631d1aa55918ac7d00af4647&network=o&partner_id=CD951&target_id=kwd-78684257341244&utm_adgroup=lc%3D169064%3Abahrain%7Cfn%3Df2%7Cci%3D937%3Athings+to+do&utm_campaign=dc%3D86%3Abh%7Clc%3D169064%3Abahrain%7Cct%3Dcore%7Cln%3D29%3Aen%7Ctc%3Dall&utm_keyword=visiting+bahrain&utm_medium=paid_search&utm_query=recommendation+of+places+to+visit+in+bahrain&utm_source=bing&visitor-id=LP0AB02GZHTQNGRI7292JGB36UBMKCNU&locale_autoredirect_optout=true" target="_blank" class="btn btn-secondary my-2">Recommendations</a>
                </p>
              </div>
            </div>
          </section>
     <!-- ========================================== -->
     <div class="album py-5 bg-body-tertiary">
        <div class="container">
    
            <% places.forEach(place => { %>  
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
                    <div class="col">
                      <div class="card mt-2 shadow-sm" style="width: 18rem;">
                        <img src="<%= place.imgUrl.url %>" class="card-img-top" alt="image">
                        <div class="card-body">
                          <h5 class="card-title"><%= place.name %></h5>
                          <a href="<%= place.location %>">Location</a>
                          <div class="d-flex justify-content-between align-items-center">
                            <div class="btn-group">
                              <a href="/users/<%= user._id %>/places/<%= place._id %>" class="btn btn-sm btn-outline-secondary">View</a>
                            </div>
                            <% if (place.category === 'Restaurant') { %>
                                <span class="badge bg-warning"><%= place.category %></span>
                              <% } else if (place.category === 'Historical') { %>
                                <span class="badge bg-info"><%= place.category %></span>
                              <% } else if (place.category === 'Cafe') { %>
                                <span class="badge bg-secondary"><%= place.category %></span>
                              <% } else if (place.category === 'Mall') { %>
                                <span class="badge bg-danger"><%= place.category %></span>
                              <% } else if (place.category === 'Entertainment') { %>
                                <span class="badge bg-success"><%= place.category %></span>
                              <% } %>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                     
    		<% }) %>
     
    </div>
  </body>
  </html>