<%- include('../partials/head') %>
    <div class="container">
        <h1> Edit <%= currentPlace.name %></h1>
        <form action="/users/<%= user._id %>/places/<%= currentPlace._id  %>?_method=PUT" method="POST">
            <label for="name">Place Name:</label>
            <input type="text" name="name" id="name" value="<%= currentPlace.name %>">
            
            <label for="location">Location:</label>
            <input type="text" name="location" id="location" value="<%= currentPlace.location %>">
            
            <label for="description">Description:</label>
            <textarea name="notes" id="description"><%= currentPlace.description %></textarea>
            
            <label for="imgUrl">Image:</label>
            <input type="text" name="imgUrl" id="imgUrl" value="<%= currentPlace.imgUrl %>">
        
            <label for="category">Category:</label>
            <select name="category" id="category">
                <option value="" selected disabled></option>
                <option value="Restaurant" <%= currentPlace.category === "Restaurant" ? "selected" : '' %>>Restaurant</option>
                <option value="Historical" <%= currentPlace.category === "Historical" ? "selected" : '' %>>Historical Site</option>
                <option value="Cafe" <%= currentPlace.category === "Cafe" ? "selected" : '' %>>Cafe</option>
                <option value="Mall" <%= currentPlace.category === "Mall" ? "selected" : '' %>>Mall</option>
                <option value="Entertainment" <%= currentPlace.category === "Entertainment" ? "selected" : '' %>>Entertainment</option>
            </select>
            
            <!-- value is the same in the model -->
             <button type="submit" class="btn btn-primary">Update Place</button>
             <a href="/users/<%= user._id %>/places/<%=currentPlace._id  %>" class="btn btn-outline-secondary btn-lg px-4">Cancel</a>            
          </form>

    </div>
<%- include('../partials/footer') %>