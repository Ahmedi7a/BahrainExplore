<%- include('../partials/head') %>
<div class="container d-flex justify-content-center align-items-start" style="min-height: 80vh;">
  <div class="card shadow-sm p-3" style="max-width: 300px; width: 100%; margin-top: 30px;">
    <h1 class="text-center mb-3">Edit <%= currentPlace.name %></h1>
    <form action="/users/<%= user._id %>/places/<%= currentPlace._id  %>?_method=PUT" method="POST" enctype="multipart/form-data" class="needs-validation" novalidate>

      <div class="mb-2">
        <label for="name" class="form-label">Place Name:</label>
        <input type="text" name="name" id="name" class="form-control" value="<%= currentPlace.name %>" required>
        <div class="invalid-feedback">
          Please enter the place name.
        </div>
      </div>

      <div class="mb-2">
        <label for="location" class="form-label">Location:</label>
        <input type="text" name="location" id="location" class="form-control" value="<%= currentPlace.location %>" required>
        <div class="invalid-feedback">
          Please enter the location.
        </div>
      </div>

      <div class="mb-2">
        <label for="description" class="form-label">Description:</label>
        <textarea name="description" id="description" class="form-control"><%= currentPlace.description %></textarea>
      </div>

      <div class="mb-2">
        <label for="imgUrl" class="form-label">Image URL:</label>
        <input type="file" name="imgUrl" accept="image/*" id="imgUrl" class="form-control" value="<%= currentPlace.imgUrl.url %>">
        <div class="invalid-feedback">
          Please enter an image URL.
        </div>
      </div>
      <% if (currentPlace.imgUrl) { %>
        <div style="display: flex; align-items: center;">
            <img src="<%= currentPlace.imgUrl.url %>" alt="Current Image" width="35" >
            <small style="margin-left: 5px;">This is the current photo</small>
        </div>
    <% } %>

      <div class="mb-2">
        <label for="category" class="form-label">Category:</label>
        <select name="category" id="category" class="form-select" required>
          <option value="" selected disabled>Choose a category</option>
          <option value="Restaurant" <%= currentPlace.category === "Restaurant" ? "selected" : '' %>>Restaurant</option>
          <option value="Historical" <%= currentPlace.category === "Historical" ? "selected" : '' %>>Historical Site</option>
          <option value="Cafe" <%= currentPlace.category === "Cafe" ? "selected" : '' %>>Cafe</option>
          <option value="Mall" <%= currentPlace.category === "Mall" ? "selected" : '' %>>Mall</option>
          <option value="Entertainment" <%= currentPlace.category === "Entertainment" ? "selected" : '' %>>Entertainment</option>
        </select>
        <div class="invalid-feedback">
          Please select a category.
        </div>
      </div>

      <button type="submit" class="btn btn-primary w-100 mt-3">Update Place</button>
      <a href="/users/<%= user._id %>/places/<%= currentPlace._id  %>" class="btn btn-outline-danger w-100 mt-3">Cancel</a>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>

<script>
  //from bootstrap
  (function () {
    'use strict'
    var forms = document.querySelectorAll('.needs-validation')
    Array.prototype.slice.call(forms)
      .forEach(function (form) {
        form.addEventListener('submit', function (event) {
          if (!form.checkValidity()) {
            event.preventDefault()
            event.stopPropagation()
          }
          form.classList.add('was-validated')
        }, false)
      })
  })()
</script>
